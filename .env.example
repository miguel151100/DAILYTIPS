# Copia este archivo a .env (local) o configura estas variables en Vercel
# (Project Settings → Environment Variables).

# API key de Anthropic (platform.claude.com)
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (Meta for Developers → tu app → WhatsApp → API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Cadena que tú inventas y pones también en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=

# App Secret de tu app de Meta (Configuración básica de la app).
# Opcional pero muy recomendado: valida que las peticiones al webhook
# vengan realmente de Meta.
WHATSAPP_APP_SECRET=
