# ── Mercado Pago ──────────────────────────────────────────────────────────────
# Ambas claves en: https://www.mercadopago.com.mx/settings/account/credentials
# La PUBLIC KEY puede ir en el frontend; el ACCESS TOKEN NUNCA.
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx
# Secreto para validar firmas de webhooks (lo genera Mercado Pago al crear el webhook)
MP_WEBHOOK_SECRET=TU_WEBHOOK_SECRET

# ── URLs ───────────────────────────────────────────────────────────────────────
SITE_URL=https://dailytips.lat
API_PUBLIC_URL=https://TU-BACKEND.vercel.app
ALLOWED_ORIGIN=https://dailytips.lat

# ── Correo (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_TU_API_KEY_DE_RESEND
MAIL_FROM=DailyTips <ventas@tudominio.com>

# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...anon-key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...service-role-key

# ── Legado (ya no se usa como contraseña única — cada orden tiene su propio token) ──
# Puedes dejar en blanco o eliminar esta variable.
DELIVERY_ACCESS_CODE=
