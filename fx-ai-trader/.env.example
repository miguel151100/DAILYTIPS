BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_ENV=testnet

# Optional: how aggressively the bot trades. Defaults shown below. Lowering
# SIGNAL_THRESHOLD or raising the exposure caps makes it trade more often --
# re-run backtest.engine with real data before trusting a change here, see
# config.py's comments for why.
# SIGNAL_THRESHOLD=0.53
# RISK_PER_TRADE=0.01
# STOP_LOSS_PERCENT=0.015
# TAKE_PROFIT_PERCENT=0.03
# MAX_DAILY_LOSS_FRACTION=0.03
# MAX_POSITIONS_PER_INSTRUMENT=1
# MAX_TOTAL_RISK_FRACTION=0.10

# Optional: leverage and margin type. Defaults are deliberately conservative
# -- low leverage keeps the liquidation price far from any reasonable
# stop-loss, and ISOLATED margin means a losing position can only lose its
# own allocated margin, not the whole account. Raise these deliberately.
# BINANCE_LEVERAGE=2
# BINANCE_MARGIN_TYPE=ISOLATED

# Optional: restrict which symbols the bot trains/trades (comma-separated).
# Left unset, it uses every USDT-margined perpetual Binance offers.
# BINANCE_SYMBOLS=BTCUSDT,ETHUSDT

# Optional: only needed for the news-blackout/sentiment filters and
# report.py. The bot's core loop (train/backtest/trade) works without these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
