OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# Optional: how aggressively the bot trades. Defaults shown below. Lowering
# FX_SIGNAL_THRESHOLD or raising the exposure caps makes it trade more often
# -- re-run backtest.engine with real data before trusting a change here,
# see config.py's comments for why.
# FX_SIGNAL_THRESHOLD=0.53
# FX_RISK_PER_TRADE=0.01
# FX_STOP_LOSS_PIPS=20
# FX_TAKE_PROFIT_PIPS=40
# FX_MAX_DAILY_LOSS_FRACTION=0.03
# FX_MAX_POSITIONS_PER_INSTRUMENT=1
# FX_MAX_TOTAL_RISK_FRACTION=0.10

# Optional: only needed for the news-blackout/sentiment filters and
# report.py. The bot's core loop (train/backtest/trade) works without these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
